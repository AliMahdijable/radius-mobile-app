<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- نسخة ماك للتجربة (موقَّعة محلّيّاً بلا فريق): بلا صندوق — الشبكة المحلّيّة (الأجهزة) و127.0.0.1
	     (الدخول عبر المتصفّح) وسلسلة المفاتيح القديمة تعمل بلا صلاحيّات فريق آبل. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
