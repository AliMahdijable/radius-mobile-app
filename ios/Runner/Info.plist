<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>MyServices Pro</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>MyServices Pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>لاختيار صورة تُرفقها برسالة جماعيّة إلى مشتركيك. To pick a photo to attach to a broadcast message to your subscribers.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>لحفظ صورة رمز QR الخاصّ بدخول المشترك في الصور عند طلبك. To save a subscriber's login QR code image to your photos when you ask.</string>
	<key>NSCameraUsageDescription</key>
	<string>تُستخدم الكاميرا فقط إن اخترت التقاط صورة لإرفاقها برسالة. The camera is used only if you choose to take a photo to attach to a message.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>لتحديد موقع المشترك على الخريطة عند إضافته أو تعديله. To set a subscriber's location on the map when you add or edit them.</string>
	<!-- 2026-08-28: Apple validator (90683) يطلب المفتاح "always and when in use"
	     حتى لو التطبيق لا يستعمل الموقع بالخلفيّة — لأن مكتبة geolocator تشير
	     للـAPI. نصّه نفس الأوّل — التطبيق يطلب "when in use" فقط عملياً. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>لتحديد موقع المشترك على الخريطة عند إضافته أو تعديله. To set a subscriber's location on the map when you add or edit them.</string>
	<!-- iOS 10 وأقدم — نفس الغرض. -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>لتحديد موقع المشترك على الخريطة عند إضافته أو تعديله. To set a subscriber's location on the map when you add or edit them.</string>
	<key>NSContactsUsageDescription</key>
	<string>لاختيار رقم هاتف مشترك من جهات الاتصال بدل كتابته. To pick a subscriber's phone number from your contacts instead of typing it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>للبحث الصوتيّ فقط، مثل قول اسم المشترك للعثور عليه. Used only for voice search, e.g. saying a subscriber's name to find them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>يحوّل كلامك إلى نصّ للبحث الصوتيّ عن المشتركين. Turns your speech into text to search your subscribers.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>لتسجيل الدخول السريع بـFace ID بدل كتابة كلمة السرّ. To sign in quickly with Face ID instead of typing your password.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>للوصول إلى أجهزة شبكتك المحلّيّة (الراوتر وأجهزة ONT) من قسم الأجهزة. To reach devices on your local network (routers, ONTs) from the Devices section.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>whatsapp</string>
		<string>tg</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Pro البند ٤: عودة نافذة دخول Google (REVERSED_CLIENT_ID) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.712556570451-op5ufm655ahcqklo9km49f15m16mj88n</string>
			</array>
		</dict>
	</array>
</dict>
</plist>